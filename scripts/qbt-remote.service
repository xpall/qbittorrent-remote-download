[Unit]
Description=qBittorrent remote download web app
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/qbittorrent-remote-download
ExecStart=%h/qbittorrent-remote-download/.venv/bin/python %h/qbittorrent-remote-download/main.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
